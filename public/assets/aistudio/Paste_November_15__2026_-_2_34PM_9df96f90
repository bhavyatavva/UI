function addConfig() {
  formModal("Add Configuration",[
    field("Configuration type","type","text","Reference Data",true,["Reporting Calendar","Validation Rule","Reconciliation Tolerance","Notification Setting","Reference Data","Workflow"]),
    field("Name","name"),
    field("Value","value"),
    field("Status","status","text","Active",true,["Active","Inactive"])
  ],"save-config");
}

function findRecord(collection,id) {
  return db[collection].find(x=>x.id===id);
}

function saveForm(collection,record,prefix,action,module) {
  record.id=makeId(prefix);
  db[collection].unshift(record);
  saveData();
  log(action,module,record.id);
  closeModal();
  toast("Record saved successfully.");
  render();
}

function handleAction(action,id) {
  let record;

  switch(action) {
    case "close-modal":
      closeModal(); return;

    case "refresh":
      render(); toast("Dashboard refreshed."); return;

    case "go-audit":
      navigate("audit"); return;

    case "add-source": addSource(); return;
    case "add-feed": addFeed(); return;
    case "add-validation": addValidation(); return;
    case "add-reconciliation": addReconciliation(); return;
    case "add-report": addReport(); return;
    case "add-exception": addException(); return;
    case "add-query": addQuery(); return;
    case "add-config": addConfig(); return;

    case "save-source": {
      const v=formValues(); if(!v)return;
      if(db.sources.some(s=>s.name.toLowerCase()===v.name.toLowerCase())){
        toast("A source with this name already exists.","error");return;
      }
      saveForm("sources",v,"SRC","Source registered","ingestion");return;
    }

    case "save-feed": {
      const v=formValues();if(!v)return;
      if(db.feeds.some(f=>f.name.toLowerCase()===v.name.toLowerCase())){
        toast("A feed with this name already exists.","error");return;
      }
      v.records=0;v.lastRun="Not run";
      saveForm("feeds",v,"FEED","Feed configured","ingestion");return;
    }

    case "save-validation": {
      const v=formValues();if(!v)return;
      v.status="Open";
      saveForm("validations",v,"VAL","Validation issue created","quality");return;
    }

    case "save-reconciliation": {
      const v=formValues();if(!v)return;
      v.expected=Number(v.expected);v.actual=Number(v.actual);
      v.status=Math.abs(v.expected-v.actual)<0.01?"Matched":"Mismatch";
      saveForm("reconciliations",v,"REC","Reconciliation created","reconciliation");
      if(v.status==="Mismatch"){
        createExceptionFromEvent("Reconciliation mismatch","Reconciliation","High","Expected and actual amounts differ.");
      }
      return;
    }

    case "save-report": {
      const v=formValues();if(!v)return;
      v.status="Draft";v.published=false;
      saveForm("reports",v,"RPT","Report created","reports");return;
    }

    case "save-exception": {
      const v=formValues();if(!v)return;
      v.status="Open";v.created=today();
      saveForm("exceptions",v,"EXC","Exception created","exceptions");return;
    }

    case "save-query": {
      const v=formValues();if(!v)return;
      v.status="Received";v.response="";
      saveForm("queries",v,"QRY","Regulatory query created","queries");return;
    }

    case "save-config": {
      const v=formValues();if(!v)return;
      saveForm("config",v,"CFG","Configuration created","configuration");return;
    }

    case "edit-source": {
      record=findRecord("sources",id);if(!record)return;
      formModal("Edit Source System",[
        field("Source name","name","text",record.name),
        field("Source type","type","text",record.type,true,["Database","API","File","Other"]),
        field("Business owner","owner","text",record.owner),
        field("Status","status","text",record.status,true,["Active","Inactive"])
      ],"update-source");return;
    }

    case "update-source": {
      const v=formValues();if(!v)return;
      record=findRecord("sources",id);
      if(!record)return;
      Object.assign(record,v);
      saveData();log("Source system updated","ingestion",record.id);
      closeModal();toast("Source updated.");render();return;
    }

    case "edit-feed": {
      record=findRecord("feeds",id);if(!record)return;
      formModal("Edit Data Feed",[
        field("Feed name","name","text",record.name),
        field("Frequency","frequency","text",record.frequency,true,["Daily","Weekly","Monthly","On Demand"]),
        field("Format","format","text",record.format,true,["CSV","JSON","XML","API"]),
        field("Status","status","text",record.status,true,["Active","Inactive"])
      ],"update-feed");return;
    }

    case "update-feed": {
      const v=formValues();if(!v)return;
      record=findRecord("feeds",id);if(!record)return;
      Object.assign(record,v);saveData();
      log("Feed updated","ingestion",record.id);
      closeModal();toast("Feed updated.");render();return;
    }

    case "run-feed": {
      record=findRecord("feeds",id);if(!record)return;
      if(record.status==="Inactive"){toast("Activate this feed before running it.","error");return;}
      const failed=Math.random()<0.18;
      const run={
        id:makeId("RUN"),feed:id,date:stamp(),
        status:failed?"Failed":"Completed",
        records:failed?0:Math.floor(Math.random()*9000+1000),
        message:failed?"Simulated source connection failure":"Simulated ingestion completed successfully"
      };
      db.runs.unshift(run);
      record.status=run.status;
      record.lastRun=today();
      record.records=run.records;
      log("Feed execution "+run.status,"ingestion",id,run.message);
      notify("Feed "+run.status,record.name+" — "+run.message,failed?"Critical":"Low","ingestion");
      if(failed) createExceptionFromEvent(record.name+" failed","Feed Failure","High",run.message);
      saveData();toast("Feed execution: "+run.status,failed?"error":"success");render();return;
    }

    case "upload-file": {
      formModal("Simulate File Upload",[
        field("Target feed","feed","text",db.feeds[0]?.id||"",true,db.feeds.map(f=>f.id)),
        field("Select CSV file","file","file"),
        field("Description","description","textarea","Demonstration upload")
      ],"process-upload","Validate and process");return;
    }

    case "process-upload": {
      const form=$("#recordForm");
      if(!form.reportValidity())return;
      const v=new FormData(form);
      const file=form.querySelector('[name="file"]').files[0];
      if(!file){toast("Choose a file first.","error");return;}
      const feedId=v.get("feed");
      const feed=findRecord("feeds",feedId);
      if(!feed)return;
      const isCsv=file.name.toLowerCase().endsWith(".csv");
      const run={
        id:makeId("RUN"),feed:feedId,date:stamp(),
        status:isCsv?"Completed":"Failed",
        records:isCsv?Math.floor(Math.random()*500+50):0,
        message:isCsv?"Demo CSV accepted. File contents are not imported.":"Unsupported file type. Please select a CSV file."
      };
      db.runs.unshift(run);feed.status=run.status;feed.lastRun=today();feed.records=run.records;
      log("File upload simulation "+run.status,"ingestion",feedId,file.name);
      if(!isCsv)notify("File validation failed",run.message,"High","ingestion");
      closeModal();saveData();toast(run.message,isCsv?"success":"error");render();return;
    }

    case "run-validation": {
      const sample=[
        {rule:"Data type validation",area:"Source data",severity:"Warning",status:"Open",details:"Sample data type check requires review.",owner:activeRole},
        {rule:"Reporting period completeness",area:"Reporting",severity:"Medium",status:"Open",details:"Sample reporting period completeness check.",owner:activeRole}
      ];
      sample.forEach(v=>{v.id=makeId("VAL");db.validations.unshift(v);});
      log("Demo validation run completed","quality","VALIDATION");
      notify("Validation completed","Illustrative validation checks were added.","Low","quality");
      saveData();toast("Demo validation completed.");render();return;
    }

    case "resolve-validation": {
      record=findRecord("validations",id);if(!record)return;
      record.status="Resolved";saveData();
      log("Validation issue resolved","quality",id);
      toast("Validation issue marked as resolved.");render();return;
    }

    case "run-calculation": {
      const types=["Credit Risk","Market Risk","Operational Risk","CVA","RWA","Capital Adequacy","Leverage","Liquidity"];
      const type=types[Math.floor(Math.random()*types.length)];
      const output=Math.floor(Math.random()*100000000+10000000);
      const c={id:makeId("CAL"),type,period:"2026-Q3",version:"Demo 1.0",status:"Completed",output};
      db.calculations.unshift(c);
      log("Illustrative calculation executed","calculations",c.id,"Demo output: "+output);
      notify("Calculation completed",type+" illustrative output is available.","Low","calculations");
      saveData();toast("Illustrative calculation completed.");render();return;
    }

    case "rerun-reconciliation": {
      record=findRecord("reconciliations",id);if(!record)return;
      record.status=Math.abs(record.expected-record.actual)<0.01?"Matched":"Mismatch";
      log("Reconciliation re-run","reconciliation",id);
      if(record.status==="Mismatch"){
        createExceptionFromEvent("Reconciliation mismatch "+id,"Reconciliation","High","Difference: "+(record.actual-record.expected));
      }
      saveData();toast("Reconciliation re-run completed.");render();return;
    }

    case "submit-report": {
      record=findRecord("reports",id);if(!record)return;
      if(record.status==="Published"){toast("This report is already published.","error");return;}
      if(record.status==="Under Review"||record.status==="Approved"){toast("This report is already in the workflow.","error");return;}
      const critical=db.validations.some(v=>v.severity==="Critical"&&v.status!=="Resolved");
      if(critical){toast("Resolve critical data quality issues before submission.","error");return;}
      record.status="Under Review";
      log("Report submitted for approval","reports",id);
      notify("Report awaiting approval",record.name+" has entered the review queue.","Medium","approvals");
      saveData();toast("Report submitted for review.");render();return;
    }

    case "approve-report": {
      record=findRecord("reports",id);if(!record)return;
      if(record.status!=="Under Review"){toast("Report is not awaiting review.","error");return;}
      if(record.owner===activeRole){toast("Maker-checker rule: you cannot approve your own report.","error");return;}
      if(db.validations.some(v=>v.severity==="Critical"&&v.status!=="Resolved")){
        toast("Critical validation issues must be resolved first.","error");return;
      }
      record.status="Approved";
      record.approvedBy=activeRole;
      record.approvedAt=stamp();
      log("Report approved","approvals",id);
      notify("Report approved",record.name+" has been approved and is eligible for publication.","Low","reports");
      saveData();toast("Report approved. It can now be published.");render();return;
    }

    case "reject-report": {
      record=findRecord("reports",id);if(!record)return;
      if(record.status!=="Under Review"){toast("Report is not awaiting review.","error");return;}
      record.status="Rejected";
      log("Report returned for correction","approvals",id);
      notify("Report returned",record.name+" was returned for correction.","High","reports");
      saveData();toast("Report returned for correction.");render();return;
    }

    case "view-report": {
      record=findRecord("reports",id);if(!record)return;
      if(currentPage==="regulator"&&(!record.published||record.status!=="Published")){
        toast("Only published reports are available in the regulator portal.","error");return;
      }
      showModal("Report details",
        `<div class="field"><label>Report ID</label><div>${esc(record.id)}</div></div>
         <div class="field"><label>Report name</label><div>${esc(record.name)}</div></div>
         <div class="field"><label>Period</label><div>${esc(record.period)}</div></div>
         <div class="field"><label>Entity</label><div>${esc(record.entity)}</div></div>
         <div class="field"><label>Status</label><div>${status(record.status)}</div></div>
         <div class="field"><label>Owner</label><div>${esc(record.owner)}</div></div>
         <div class="info-banner">Illustrative report preview. No certified regulatory figures are included.</div>`,
        `<button class="btn btn-secondary" data-action="close-modal">Close</button>
         ${record.status==="Approved"?`<button class="btn btn-primary" data-action="publish-report" data-id="${record.id}">Publish report</button>`:""}`
      );return;
    }

    case "publish-report": {
      record=findRecord("reports",id);if(!record)return;
      if(record.status!=="Approved"){toast("Only approved reports can be published.","error");return;}
      record.status="Published";record.published=true;record.publishedAt=stamp();
      log("Report published to demo regulator portal","reports",id);
      notify("Report published",record.name+" is now visible in the regulator portal.","Low","regulator");
      saveData();closeModal();toast("Report published to the demo portal.");render();return;
    }

    case "resolve-exception": {
      record=findRecord("exceptions",id);if(!record)return;
      record.status="Resolved";record.resolvedAt=stamp();
      log("Exception resolved","exceptions",id);
      saveData();toast("Exception marked as resolved.");render();return;
    }

    case "read-notification": {
      record=findRecord("notifications",id);if(!record)return;
      record.read=true;saveData();render();return;
    }

    case "read-all": {
      db.notifications.forEach(n=>n.read=true);
      saveData();toast("All notifications marked as read.");render();return;
    }

    case "respond-query": {
      record=findRecord("queries",id);if(!record)return;
      formModal("Respond to Regulatory Query",[
        field("Response","response","textarea",record.response||""),
        field("Status","status","text",record.status,true,["Received","Assigned","In Progress","Response Submitted","Under Review","Closed"])
      ],"save-query-response");return;
    }

    case "save-query-response": {
      const v=formValues();if(!v)return;
      record=findRecord("queries",id);if(!record)return;
      record.response=v.response;record.status=v.status;
      record.responseUpdated=stamp();
      log("Regulatory query response updated","queries",id);
      saveData();closeModal();toast("Query response updated.");render();return;
    }

    case "edit-config": {
      record=findRecord("config",id);if(!record)return;
      formModal("Edit Configuration",[
        field("Configuration type","type","text",record.type),
        field("Name","name","text",record.name),
        field("Value","value","text",record.value),
        field("Status","status","text",record.status,true,["Active","Inactive"])
      ],"update-config");return;
    }

    case "update-config": {
      const v=formValues();if(!v)return;
      record=findRecord("config",id);if(!record)return;
      Object.assign(record,v);saveData();
      log("Configuration updated","configuration",id);
      closeModal();toast("Configuration updated.");render();return;
    }

    case "export-audit":
      exportCSV("reg-vision-audit.csv",db.audit);return;

    case "export-reports":
      exportCSV("reg-vision-reports.csv",db.reports);return;

    case "reset-data":
      if(activeRole!=="Regulatory Administrator"){toast("Only the Regulatory Administrator demo role can reset the demo.","error");return;}
      if(confirm("Reset all REG VISION demo records to their initial values?")){
        db=structuredClone(seedData);
        localStorage.setItem("regVisionData",JSON.stringify(db));
        log("Demo data reset","configuration","RESET");
        toast("Demo records reset.");
        navigate("dashboard");
      }
      return;
  }
}

function createExceptionFromEvent(title,category,severity,details) {
  const e={
    id:makeId("EXC"),title,category,severity,
    priority:severity,assignee:"Unassigned",status:"Open",
    details,created:today()
  };
  db.exceptions.unshift(e);
  log("Exception generated automatically","exceptions",e.id,details);
}

function exportCSV(filename,records) {
  if(!records.length){toast("There are no records to export.","error");return;}
  const headers=[...new Set(records.flatMap(r=>Object.keys(r)))];
  const quote=value=>`"${String(value??"").replace(/"/g,'""')}"`;
  const csv=[
    headers.map(quote).join(","),
    ...records.map(r=>headers.map(h=>quote(r[h])).join(","))
  ].join("\r\n");
  const blob=new Blob([csv],{type:"text/csv;charset=utf-8"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url;a.download=filename;a.click();
  URL.revokeObjectURL(url);
  toast("CSV export prepared.");
}

/* =========================================================
   EVENT HANDLERS AND APPLICATION INITIALIZATION
========================================================= */

$("#navigation").addEventListener("click",event=>{
  const item=event.target.closest("[data-page]");
  if(item)navigate(item.dataset.page);
});

$("#appContent").addEventListener("click",event=>{
  const control=event.target.closest("[data-action]");
  if(!control)return;
  handleAction(control.dataset.action,control.dataset.id);
});

$("#modalActions").addEventListener("click",event=>{
  const control=event.target.closest("[data-action]");
  if(!control)return;
  handleAction(control.dataset.action,control.dataset.id);
});

$("#modalClose").addEventListener("click",closeModal);
$("#modalBackdrop").addEventListener("click",event=>{
  if(event.target.id==="modalBackdrop")closeModal();
});

$("#menuToggle").addEventListener("click",()=>{
  $("#sidebar").classList.toggle("open");
});

$("#notificationButton").addEventListener("click",()=>{
  navigate("notifications");
});

$("#roleSelector").addEventListener("change",event=>{
  activeRole=event.target.value;
  localStorage.setItem("rv_role",activeRole);
  log("Demo role changed","configuration",activeRole);
  updateProfile();
  if(!canAccess(currentPage))currentPage="dashboard";
  render();
  toast("Demo role switched to "+activeRole+".");
});

function updateProfile() {
  $("#userName").textContent=activeRole==="Regulator / Supervisory User"?"Supervisory User":"Demo User";
  $("#userRole").textContent=activeRole;
  $("#userAvatar").textContent=activeRole.split(" ").map(w=>w[0]).join("").slice(0,2).toUpperCase();
}

function initialize() {
  loadData();

  if(!ROLES.includes(activeRole))activeRole="Regulatory Administrator";

  $("#roleSelector").innerHTML=ROLES.map(r=>
    `<option value="${esc(r)}" ${r===activeRole?"selected":""}>${esc(r)}</option>`
  ).join("");

  updateProfile();
  log("Application session started","dashboard","SESSION","Demo session initialized");
  render();
}

initialize();
