    {id:"FEED-001",name:"Daily GL Feed",source:"SRC-002",frequency:"Daily",format:"CSV",status:"Completed",lastRun:today(),records:12500},
    {id:"FEED-002",name:"Credit Risk Feed",source:"SRC-003",frequency:"Daily",format:"API",status:"Completed",lastRun:today(),records:8200},
