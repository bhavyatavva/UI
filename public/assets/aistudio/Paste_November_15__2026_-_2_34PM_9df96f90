    {id:"CFG-002",type:"Validation Rule",name:"Mandatory field validation",value:"Enabled",status:"Active"},
    {id:"CFG-003",type:"Reconciliation Tolerance",name:"Default tolerance",value:"0.5%",status:"Active"}
  ]
};

let db;
let activeRole = localStorage.getItem("rv_role") || "Regulatory Administrator";
let currentPage = "dashboard";
let chartInstances = [];

function loadData() {
  try {
    const saved = localStorage.getItem("regVisionData");
    db = saved ? JSON.parse(saved) : structuredClone(seedData);
  } catch {
    db = structuredClone(seedData);
  }
  Object.keys(seedData).forEach(key => {
    if (!Array.isArray(db[key])) db[key] = structuredClone(seedData[key]);
  });
  saveData();
}

function saveData() {
  localStorage.setItem("regVisionData", JSON.stringify(db));
}

function log(action,module,reference,details="") {
  db.audit.unshift({
    id:makeId("AUD"),
    user:activeRole,
    action,
    module,
    reference,
    details,
    date:stamp()
  });
  saveData();
}

function notify(title,message,severity="Medium",module=currentPage) {
  db.notifications.unshift({
    id:makeId("NTF"),title,message,severity,
    read:false,date:stamp(),module
  });
  saveData();
  updateNotificationDot();
}

function toast(message,type="success") {
  const el=document.createElement("div");
  el.className="toast "+type;
  el.textContent=message;
  $("#toastContainer").appendChild(el);
  setTimeout(()=>el.remove(),3500);
}

function canAccess(page) {
  return (ACCESS[activeRole] || []).includes(page);
}

function updateNotificationDot() {
  const unread=db.notifications.filter(n=>!n.read).length;
  $("#notificationDot").style.display=unread ? "block":"none";
}

function status(value) {
  return `<span class="status ${statusClass(value)}">${esc(value)}</span>`;
}

function pageHeading(title,description,buttons="") {
  return `<div class="page-heading">
    <div><h1>${esc(title)}</h1><p>${esc(description)}</p></div>
    <div class="toolbar">${buttons}</div>
  </div>`;
}

function button(label,action,kind="secondary",extra="") {
  return `<button class="btn btn-${kind}" data-action="${esc(action)}" ${extra}>${esc(label)}</button>`;
}

function metric(label,value,icon,foot="Current demo records") {
  return `<div class="kpi-card">
    <div class="kpi-top"><span>${esc(label)}</span><span class="kpi-icon">${icon}</span></div>
    <div class="kpi-value">${esc(value)}</div><div class="kpi-foot">${esc(foot)}</div>
  </div>`;
}

function table(headers,rows,empty="No records found.") {
  if (!rows.length) return `<div class="empty-state"><strong>${esc(empty)}</strong>Records will appear here when available.</div>`;
  return `<div class="table-wrap"><table><thead><tr>${headers.map(h=>`<th>${esc(h)}</th>`).join("")}</tr></thead><tbody>${rows.join("")}</tbody></table></div>`;
}

function panel(title,content,subtitle="") {
  return `<section class="panel"><div class="panel-heading"><h3>${esc(title)}</h3><small>${esc(subtitle)}</small></div>${content}</section>`;
}

function showModal(title,body,actions="") {
  $("#modalTitle").textContent=title;
  $("#modalBody").innerHTML=body;
  $("#modalActions").innerHTML=actions || `<button class="btn btn-secondary" data-action="close-modal">Close</button>`;
  $("#modalBackdrop").classList.add("open");
}

function closeModal() {
  $("#modalBackdrop").classList.remove("open");
}

function field(label,name,type="text",value="",required=true,options=null) {
  let control;
  if (options) {
    control=`<select name="${esc(name)}" ${required?"required":""}>${options.map(o=>`<option value="${esc(o)}" ${o===value?"selected":""}>${esc(o)}</option>`).join("")}</select>`;
  } else if(type==="textarea") {
    control=`<textarea name="${esc(name)}" ${required?"required":""}>${esc(value)}</textarea>`;
  } else {
    control=`<input name="${esc(name)}" type="${type}" value="${esc(value)}" ${required?"required":""}>`;
  }
  return `<div class="field"><label>${esc(label)}</label>${control}</div>`;
}

function formModal(title,fields,submitAction,submitLabel="Save") {
  showModal(title,
    `<form id="recordForm"><div class="form-grid">${fields.join("")}</div></form>`,
    `<button class="btn btn-secondary" data-action="close-modal">Cancel</button>
     <button class="btn btn-primary" data-action="${submitAction}">${submitLabel}</button>`
  );
}

function formValues() {
  const form=$("#recordForm");
  if (!form) return null;
  if (!form.reportValidity()) return null;
  return Object.fromEntries(new FormData(form).entries());
}

function render() {
  if (!canAccess(currentPage)) currentPage="dashboard";
  $("#breadcrumb").textContent=MODULES.find(m=>m[0]===currentPage)?.[1] || "Dashboard";
  document.querySelectorAll(".nav-link").forEach(el=>{
    el.classList.toggle("active",el.dataset.page===currentPage);
    el.style.display=canAccess(el.dataset.page)?"flex":"none";
  });
  document.querySelectorAll(".chart-panel canvas").forEach(c=>c.remove());
  chartInstances.forEach(c=>c.destroy());
  chartInstances=[];
  const pages={
    dashboard:renderDashboard,
    ingestion:renderIngestion,
    quality:renderQuality,
    calculations:renderCalculations,
    reconciliation:renderReconciliation,
    reports:renderReports,
    approvals:renderApprovals,
    regulator:renderRegulator,
    audit:renderAudit,
    exceptions:renderExceptions,
    notifications:renderNotifications,
    queries:renderQueries,
    configuration:renderConfiguration
  };
  $("#appContent").innerHTML=pages[currentPage]();
  document.querySelectorAll(".nav-link").forEach(el=>el.classList.toggle("active",el.dataset.page===currentPage));
  updateNotificationDot();
  if(currentPage==="dashboard") drawDashboardCharts();
}

function navigate(page) {
  if(!canAccess(page)) {
    toast("Your demo role does not have access to this module.","error");
    return;
  }
  currentPage=page;
  $("#sidebar").classList.remove("open");
  render();
}

function renderDashboard() {
  const published=db.reports.filter(r=>r.published).length;
  const approved=db.reports.filter(r=>r.status==="Approved").length;
  const pending=db.reports.filter(r=>["Under Review","Draft","Generated","Validation Pending"].includes(r.status)).length;
  const failed=db.feeds.filter(f=>f.status==="Failed").length;
  const openExc=db.exceptions.filter(e=>!["Closed","Resolved"].includes(e.status)).length;
  const critical=db.validations.filter(v=>v.severity==="Critical"&&v.status!=="Resolved").length;
  const pendingQueries=db.queries.filter(q=>q.status!=="Closed").length;
  return `
    ${pageHeading("Executive Dashboard","Operational overview of the Basel IV reporting lifecycle.",button("Refresh","refresh","secondary"))}
    <div class="info-banner">This dashboard uses shared illustrative demo records. Values are not actual regulatory submissions or certified Basel IV calculations.</div>
    <div class="kpi-grid">
      ${metric("Total reports",db.reports.length,"▤")}
      ${metric("Approved reports",approved,"✓")}
      ${metric("Published reports",published,"▣")}
      ${metric("Reports awaiting action",pending,"◷")}
      ${metric("Failed data feeds",failed,"⇧")}
      ${metric("Open exceptions",openExc,"⚑")}
      ${metric("Critical data issues",critical,"!")}
      ${metric("Open regulatory queries",pendingQueries,"?")}
    </div>
    <div class="dashboard-grid">
      <div class="chart-panel"><div class="panel-heading"><h3>Report status distribution</h3><small>Current records</small></div><div class="chart-wrap"><canvas id="reportChart"></canvas></div></div>
      <div class="chart-panel"><div class="panel-heading"><h3>Data feed health</h3><small>Current feed status</small></div><div class="chart-wrap"><canvas id="feedChart"></canvas></div></div>
    </div>
    <div class="dashboard-grid">
      ${panel("Operational alerts",db.notifications.slice(0,5).map(n=>`<div class="list-row"><div><strong>${esc(n.title)}</strong><small>${esc(n.message)}</small></div>${status(n.severity)}</div>`).join("")||`<div class="empty-state">No alerts.</div>`)}
      ${panel("Reporting lifecycle",`<div class="lineage"><span>Source</span><b>→</b><span>Ingestion</span><b>→</b><span>Validation</span><b>→</b><span>Reconciliation</span><b>→</b><span>Report</span><b>→</b><span>Approval</span><b>→</b><span>Publication</span></div>`)}
    </div>
    <div class="table-panel"><div class="table-heading"><h3>Recent reporting activity</h3>${button("View audit trail","go-audit","secondary")}</div>
      ${table(["Event","User / Role","Module","Date"],db.audit.slice(0,6).map(a=>`<tr><td>${esc(a.action)} · ${esc(a.reference)}</td><td>${esc(a.user)}</td><td>${esc(a.module)}</td><td>${esc(a.date)}</td></tr>`),"No audit activity yet.")}</div>
  `;
}

function drawDashboardCharts() {
  if(!window.Chart)return;
  const reportCounts={};
  db.reports.forEach(r=>reportCounts[r.status]=(reportCounts[r.status]||0)+1);
  const feedCounts={};
  db.feeds.forEach(f=>feedCounts[f.status]=(feedCounts[f.status]||0)+1);
  const a=$("#reportChart"),b=$("#feedChart");
  if(a) chartInstances.push(new Chart(a,{type:"doughnut",data:{labels:Object.keys(reportCounts),datasets:[{data:Object.values(reportCounts)}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:"bottom"}}}}));
  if(b) chartInstances.push(new Chart(b,{type:"bar",data:{labels:Object.keys(feedCounts),datasets:[{label:"Feeds",data:Object.values(feedCounts)}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}}}));
}

